registry=https://registry.npmmirror.com
# pnpm 11 将 onlyBuiltDependencies 从 package.json 移到 .npmrc
# 允许这些包执行 postinstall build scripts，否则 ERR_PNPM_IGNORED_BUILDS
only-built-dependencies[]=@parcel/watcher
only-built-dependencies[]=core-js-pure
only-built-dependencies[]=es5-ext
only-built-dependencies[]=esbuild