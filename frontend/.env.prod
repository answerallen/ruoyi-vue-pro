# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径。生产置空：base_url = VITE_BASE_URL + VITE_API_URL = /admin-api
# 走 nginx 同源反代(/admin-api -> backend:48080)，避免每个浏览器打 localhost:48080 导致"系统异常"
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否开启登录验证码(false 直接登录, 不弹滑块; 生产已用 -Dyudao.captcha.enable=false 关后端校验)
VITE_APP_CAPTCHA_ENABLE='false'
# 是否启用多租户(false 不弹租户输入/查询, 单租户直接登录)
VITE_APP_TENANT_ENABLE='false'

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN='http://mall.yudao.iocoder.cn'

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'
